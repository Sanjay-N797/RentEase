# Uploaded files are DATA only: never execute anything here.
Options -ExecCGI -Indexes
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .phar .pl .py .cgi
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .phar
# deny everything, then allow plain images only
Require all denied
<FilesMatch "\.(jpe?g|png|webp)$">
  Require all granted
</FilesMatch>
